# Kopieren nach .env und Werte anpassen:  cp .env.example .env && nano .env

# Dein Login für die App
APP_USER_EMAIL=du@example.org
APP_USER_PASSWORD=BITTE-AENDERN-mindestens-10-Zeichen

# Admin-Konto für PocketBase (Dashboard /_/ und Worker). Anderes Passwort als oben!
PB_SUPERUSER_EMAIL=admin@example.org
PB_SUPERUSER_PASSWORD=BITTE-AENDERN-langes-Admin-Passwort

# Spracherkennung: tiny | base | small | medium  (größer = genauer, aber langsamer)
WHISPER_MODEL=small
# leer = Sprache automatisch erkennen (gut für Englisch+Deutsch gemischt), sonst z. B. en
WHISPER_LANGUAGE=
# 0 = alle CPU-Kerne des Containers
WHISPER_THREADS=0

# KI-Stimmen (Piper). Weitere: https://rhasspy.github.io/piper-samples/
# Nur Stimmen mit freier Datensatz-Lizenz wählen (MODEL_CARD prüfen: public domain, CC0, CC-BY).
# cori (GB) und ljspeech (US) sind public domain. lessac-Stimmen sind nur für
# Forschung lizenziert und werden vom Worker automatisch ersetzt.
PIPER_VOICE_GB=en_GB-cori-high
PIPER_VOICE_US=en_US-ljspeech-high
# Sprechtempo: 1.0 normal, größer = langsamer
PIPER_LENGTH_SCALE=1.05

# Betreiber für die Datenschutzseite (/legal/datenschutz.html).
# Wichtig, sobald andere die App nutzen. Wird nur angezeigt, nicht im Repo gespeichert.
APP_OPERATOR_NAME=Vorname Nachname
APP_OPERATOR_CONTACT=mail@example.org
# Läuft der Zugang über einen Dienstleister (z. B. Cloudflare-Tunnel)? Dann hier eintragen,
# er wird auf der Datenschutzseite genannt. Leer lassen, wenn nicht.
APP_PROXY_PROVIDER=
